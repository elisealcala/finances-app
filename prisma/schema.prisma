generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// DEBT MODULE
// ============================================

enum DebtType {
  CREDIT_CARD
  PERSONAL_LOAN
  MORTGAGE
  AUTO_LOAN
  STUDENT_LOAN
  OTHER
}

enum DebtStatus {
  ACTIVE
  PAID_OFF
}

enum InstallmentStatus {
  PENDING
  PAID
}

model Debt {
  id              String     @id @default(cuid())
  name            String
  type            DebtType
  originalBalance Decimal    @map("original_balance") @db.Decimal(12, 2)
  balance         Decimal    @db.Decimal(12, 2)
  interestRate    Decimal    @map("interest_rate") @db.Decimal(5, 2)
  monthlyCapital                Decimal    @map("monthly_capital") @db.Decimal(10, 2)
  monthlyInterest               Decimal    @map("monthly_interest") @db.Decimal(10, 2)
  originalMonthlyCapital        Decimal    @map("original_monthly_capital") @db.Decimal(10, 2)
  originalMonthlyInterest       Decimal    @map("original_monthly_interest") @db.Decimal(10, 2)
  minimumPayment                Decimal    @map("minimum_payment") @db.Decimal(10, 2)
  originalMinimumPayment        Decimal    @map("original_minimum_payment") @db.Decimal(10, 2)
  dueDate                Int?       @map("due_date")
  lender          String?
  notes           String?
  color           String?
  fees            Json?      @db.Json
  startedAt       DateTime?  @map("started_at")
  status          DebtStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  hasSchedule  Boolean    @default(false) @map("has_schedule")
  termMonths   Int?       @map("term_months")

  account               Account?
  payments              DebtPayment[]
  installments          DebtInstallment[]

  @@map("debts")
}

model DebtPayment {
  id        String   @id @default(cuid())
  amount            Decimal  @db.Decimal(12, 2)
  date              DateTime
  notes             String?
  newMonthlyCapital  Decimal? @map("new_monthly_capital") @db.Decimal(10, 2)
  newMonthlyInterest Decimal? @map("new_monthly_interest") @db.Decimal(10, 2)
  newMinimumPayment  Decimal? @map("new_minimum_payment") @db.Decimal(10, 2)
  newFees            Json?    @map("new_fees") @db.Json
  debtId            String   @map("debt_id")
  createdAt DateTime @default(now()) @map("created_at")

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@map("debt_payments")
}

model DebtInstallment {
  id                String            @id @default(cuid())
  installmentNumber Int               @map("installment_number")
  dueDate           DateTime          @map("due_date")
  capital           Decimal           @db.Decimal(10, 2)
  interest          Decimal           @db.Decimal(10, 2)
  fees              Json?             @db.Json
  totalAmount       Decimal           @map("total_amount") @db.Decimal(10, 2)
  status            InstallmentStatus @default(PENDING)
  paidAt            DateTime?         @map("paid_at")
  notes             String?
  debtId            String            @map("debt_id")
  createdAt         DateTime          @default(now()) @map("created_at")

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@unique([debtId, installmentNumber])
  @@index([debtId])
  @@map("debt_installments")
}

// ============================================
// FINANCES MODULE
// ============================================

enum AccountType {
  BANK
  CREDIT_CARD
  CASH
  SAVINGS
  INVESTMENT
  OTHER
}

enum PaymentStatus {
  PAID
  NOT_PAID
}

enum Currency {
  PEN
  USD
  EUR
}

enum StatementStatus {
  OPEN
  CLOSED
  PAID
}

model Account {
  id                     String      @id @default(cuid())
  name                   String
  type                   AccountType
  opening                Decimal     @db.Decimal(12, 2)
  currency               Currency    @default(PEN)
  secondaryCurrency      Currency?   @map("secondary_currency")
  color                  String?
  notes                  String?
  isArchived             Boolean     @default(false) @map("is_archived")
  creditLimit            Decimal?    @map("credit_limit") @db.Decimal(12, 2)
  apr                    Decimal?    @db.Decimal(5, 2)
  billingDay             Int?        @map("billing_day")
  paymentDueDay          Int?        @map("payment_due_day")
  defaultPayingAccountId String?     @map("default_paying_account_id")
  debtId                 String?     @unique @map("debt_id")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  debt                  Debt?                  @relation(fields: [debtId], references: [id])
  defaultPayingAccount  Account?               @relation("DefaultPayingAccount", fields: [defaultPayingAccountId], references: [id])
  defaultPayingFor      Account[]              @relation("DefaultPayingAccount")
  expenses              Expense[]
  expensesPaying        Expense[]              @relation("ExpensePayingAccount")
  incomes               Income[]
  transfersFrom         Transfer[]             @relation("TransferFrom")
  transfersTo           Transfer[]             @relation("TransferTo")
  statements            CreditCardStatement[]

  @@map("accounts")
}

model Category {
  id            String    @id @default(cuid())
  name          String    @unique
  monthlyBudget Decimal?  @map("monthly_budget") @db.Decimal(12, 2)
  color         String?
  icon          String?
  isArchived    Boolean   @default(false) @map("is_archived")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  expenses              Expense[]
  incomes               Income[]
  @@map("categories")
}

model Expense {
  id              String        @id @default(cuid())
  name            String
  amount          Decimal       @db.Decimal(12, 2)
  date            DateTime
  paymentStatus   PaymentStatus @default(PAID) @map("payment_status")
  currency        Currency?
  notes           String?
  accountId       String        @map("account_id")
  categoryId      String?       @map("category_id")
  payingAccountId String?       @map("paying_account_id")
  paymentDueDate  DateTime?     @map("payment_due_date")
  statementId     String?       @map("statement_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  account       Account               @relation(fields: [accountId], references: [id])
  category      Category?             @relation(fields: [categoryId], references: [id])
  payingAccount Account?              @relation("ExpensePayingAccount", fields: [payingAccountId], references: [id])
  statement     CreditCardStatement?  @relation(fields: [statementId], references: [id])

  @@index([date])
  @@index([statementId])
  @@map("expenses")
}

model Income {
  id         String    @id @default(cuid())
  name       String
  amount     Decimal   @db.Decimal(12, 2)
  date       DateTime
  notes      String?
  currency   Currency?
  accountId  String    @map("account_id")
  categoryId String?   @map("category_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  account  Account   @relation(fields: [accountId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([date])
  @@map("incomes")
}

model CreditCardStatement {
  id               String          @id @default(cuid())
  accountId        String          @map("account_id")
  month            Int
  year             Int
  billingCloseDate DateTime        @map("billing_close_date")
  paymentDueDate   DateTime        @map("payment_due_date")
  totalAmount      Decimal?        @map("total_amount") @db.Decimal(12, 2)
  status           StatementStatus @default(OPEN)
  notes            String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([accountId])
  @@map("credit_card_statements")
}

model Transfer {
  id            String    @id @default(cuid())
  name          String
  amount        Decimal   @db.Decimal(12, 2)
  currency      Currency?
  rate          Decimal?  @db.Decimal(20, 8)
  date          DateTime
  notes         String?
  fromAccountId String    @map("from_account_id")
  toAccountId   String    @map("to_account_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  fromAccount Account @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccount   Account @relation("TransferTo", fields: [toAccountId], references: [id])

  @@index([date])
  @@map("transfers")
}

// ============================================
// HEALTH MODULE
// ============================================

enum AttachmentKind {
  RECEIPT
  ANALYSIS
  OTHER
}

model DoctorAppointment {
  id         String   @id @default(cuid())
  date       DateTime
  specialty  String
  doctorName String?  @map("doctor_name")
  cost       Decimal? @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  medications Medication[]
  attachments Attachment[]

  @@index([date])
  @@map("doctor_appointments")
}

model Medication {
  id            String  @id @default(cuid())
  name          String
  dosage        String?
  frequency     String?
  appointmentId String  @map("appointment_id")

  appointment DoctorAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("medications")
}

model Attachment {
  id            String         @id @default(cuid())
  url           String
  filename      String
  mimeType      String         @map("mime_type")
  size          Int?
  kind          AttachmentKind @default(OTHER)
  appointmentId String?        @map("appointment_id")
  createdAt     DateTime       @default(now()) @map("created_at")

  appointment DoctorAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@map("attachments")
}

// ============================================
// NOTES MODULE
// ============================================

model Note {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  title     String?
  content   Json     @db.Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@map("notes")
}

// ============================================
// TELEGRAM ASSISTANT MODULE
// ============================================

enum AssistantRole {
  USER
  ASSISTANT
}

model AssistantMessage {
  id        String        @id @default(cuid())
  chatId    String        @map("chat_id")
  role      AssistantRole
  content   String        @db.Text
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([chatId, createdAt])
  @@map("assistant_messages")
}

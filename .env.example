# Supabase PostgreSQL - pooled connection (for app runtime)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL - direct connection (for Prisma migrations)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenAI (performance plan generation)
OPENAI_API_KEY="sk-..."
# Optional override. Defaults to the current flagship model.
OPENAI_MODEL="gpt-5.6-sol"

# Optional personal token for private repository evidence and repository creation.
GITHUB_TOKEN="github_pat_..."

# Local Obsidian knowledge vault (read-only source)
OBSIDIAN_KNOWLEDGE_PATH="/Users/your-name/Sites/obsidian/knowledge"

# Notion (for migration script)
NOTION_TOKEN="ntn_..."
